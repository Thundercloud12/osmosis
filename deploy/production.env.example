# Public origin of the static web app. Must exactly match the browser origin.
CLIENT_ORIGINS=https://play.example.com

# Set these to the existing LiveKit Cloud project credentials. Leave all blank
# only if voice is intentionally disabled for this deployment.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Generate unique values with: openssl rand -hex 32
RECONNECT_SECRET=replace-with-a-random-secret
METRICS_TOKEN=replace-with-a-different-random-token

# Keep false until the production abuse-report review process is ready.
ENABLE_QUICK_PLAY=false

# Paste the token from the named Cloudflare Tunnel created for this deployment.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
