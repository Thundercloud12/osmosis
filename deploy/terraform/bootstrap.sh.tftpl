#!/bin/bash
set -euo pipefail

dnf install -y docker python3
systemctl enable --now docker
systemctl enable --now amazon-ssm-agent

# Serve the public WSS hostname directly from EC2. Caddy terminates TLS and
# forwards requests to the Colyseus port, which Compose binds to localhost.
install -d -m 0755 /etc/osmosis /var/lib/osmosis-caddy/data /var/lib/osmosis-caddy/config
cat > /etc/osmosis/Caddyfile <<'CADDYFILE'
${game_hostname} {
  reverse_proxy 127.0.0.1:2567
}
CADDYFILE

docker pull caddy:2
cat > /etc/systemd/system/osmosis-caddy.service <<'UNIT'
[Unit]
Description=Osmosis Caddy HTTPS and WebSocket reverse proxy
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f osmosis-caddy
ExecStart=/usr/bin/docker run --rm --name osmosis-caddy --network host -v /etc/osmosis/Caddyfile:/etc/caddy/Caddyfile:ro -v /var/lib/osmosis-caddy/data:/data -v /var/lib/osmosis-caddy/config:/config caddy:2
ExecStop=/usr/bin/docker stop --time 10 osmosis-caddy
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now osmosis-caddy
