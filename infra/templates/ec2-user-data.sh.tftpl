#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

exec > >(tee -a /var/log/osmosis-bootstrap.log | logger -t osmosis-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl gnupg jq python3 snapd unzip

# Install AWS CLI v2 from AWS's official installer. Ubuntu's repositories do
# not consistently provide an awscli package for this Ubuntu 24.04 image.
aws_cli_installer="$(mktemp)"
trap 'rm -f "$aws_cli_installer"' EXIT
curl -fsSL https://awscli.amazonaws.com/v2/install.sh -o "$aws_cli_installer"
bash "$aws_cli_installer" --system
rm -f "$aws_cli_installer"
trap - EXIT
aws --version

# Docker's official Ubuntu repository.
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
cat > /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "$${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

# Caddy's official stable Ubuntu repository.
curl -1sLf https://dl.cloudsmith.io/public/caddy/stable/gpg.key \
  | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
curl -1sLf https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt \
  -o /etc/apt/sources.list.d/caddy-stable.list
chmod o+r /usr/share/keyrings/caddy-stable-archive-keyring.gpg /etc/apt/sources.list.d/caddy-stable.list

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin caddy
systemctl enable --now docker

install -d -m 0755 /etc/docker
cat > /etc/docker/daemon.json <<'EOF'
{"log-driver":"json-file","log-opts":{"max-size":"10m","max-file":"3"}}
EOF
systemctl restart docker

# Ubuntu 24.04 AWS images normally ship with SSM Agent. Ensure it is installed
# and enabled so administration works without inbound SSH.
if ! snap list amazon-ssm-agent >/dev/null 2>&1; then
  snap install amazon-ssm-agent --classic
fi
snap start --enable amazon-ssm-agent || true
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || true

# Install the CloudWatch Agent after validating its AWS-published signature.
cw_tmp="$(mktemp -d)"
trap 'rm -rf "$cw_tmp"' EXIT
curl -fsSL https://amazoncloudwatch-agent.s3.amazonaws.com/assets/amazon-cloudwatch-agent.gpg \
  -o "$cw_tmp/amazon-cloudwatch-agent.gpg"
curl -fsSL https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb \
  -o "$cw_tmp/amazon-cloudwatch-agent.deb"
curl -fsSL https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb.sig \
  -o "$cw_tmp/amazon-cloudwatch-agent.deb.sig"
install -m 0700 -d "$cw_tmp/gnupg"
gpg --homedir "$cw_tmp/gnupg" --batch --import "$cw_tmp/amazon-cloudwatch-agent.gpg"
fingerprint="$(gpg --homedir "$cw_tmp/gnupg" --batch --with-colons --fingerprint | awk -F: '$1 == "fpr" { print $10; exit }')"
test "$fingerprint" = "937616F3450B7D806CBD9725D58167303B789C72"
gpg --homedir "$cw_tmp/gnupg" --batch --verify \
  "$cw_tmp/amazon-cloudwatch-agent.deb.sig" "$cw_tmp/amazon-cloudwatch-agent.deb"
apt-get install -y "$cw_tmp/amazon-cloudwatch-agent.deb"
rm -rf "$cw_tmp"
trap - EXIT

install -d -m 0755 /opt/osmosis/deploy
install -d -o caddy -g caddy -m 0750 /var/log/caddy
printf '%s' '${compose_file_b64}' | base64 -d > /opt/osmosis/deploy/compose.production.yaml
printf '%s' '${deploy_script_b64}' | base64 -d > /opt/osmosis/deploy/deploy-on-ec2.sh
chmod 0644 /opt/osmosis/deploy/compose.production.yaml
chmod 0750 /opt/osmosis/deploy/deploy-on-ec2.sh
chown -R root:root /opt/osmosis

cat > /etc/caddy/Caddyfile <<'CADDY'
${game_hostname} {
  encode zstd gzip
  log {
    output file /var/log/caddy/access.log {
      roll_size 10MiB
      roll_keep 5
    }
  }
  reverse_proxy 127.0.0.1:2567
}
CADDY
systemctl enable --now caddy
systemctl reload caddy

install -d -m 0755 /opt/aws/amazon-cloudwatch-agent/etc
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWAGENT'
{
  "metrics": {
    "namespace": "Osmosis/EC2",
    "append_dimensions": { "InstanceId": "$${aws:InstanceId}" },
    "aggregation_dimensions": [["InstanceId"]],
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"], "metrics_collection_interval": 60 },
      "disk": {
        "measurement": ["used_percent"],
        "metrics_collection_interval": 60,
        "resources": ["/"],
        "drop_device": true
      }
    }
  }
}
CWAGENT
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s

echo "Osmosis host bootstrap completed for ${game_hostname} in ${aws_region}."
