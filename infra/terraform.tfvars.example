aws_region     = "ap-south-1"
subnet_id      = "subnet-0fbd118cb7d4e59e4"
instance_type  = "t3.medium"
game_domain    = "keerthanpoojary.tech"

# Obtain this ID from the Cloudflare zone dashboard or API; never guess it.
